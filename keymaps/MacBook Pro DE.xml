    <keyboard-shortcut first-keystroke="meta alt #10000fc" second-keystroke="1"/>
  </action>
  <!-- [DE] macOS: meta alt MULTIPLY 2 | meta alt MULTIPLY NUMPAD2 -->
  <action id="ExpandAllToLevel2">
    <keyboard-shortcut first-keystroke="meta alt #10000fc" second-keystroke="2"/>
  </action>
  <!-- [DE] macOS: meta alt MULTIPLY 3 | meta alt MULTIPLY NUMPAD3 -->
  <action id="ExpandAllToLevel3">
    <keyboard-shortcut first-keystroke="meta alt #10000fc" second-keystroke="3"/>
  </action>
  <!-- [DE] macOS: meta alt MULTIPLY 4 | meta alt MULTIPLY NUMPAD4 -->
  <action id="ExpandAllToLevel4">
    <keyboard-shortcut first-keystroke="meta alt #10000fc" second-keystroke="4"/>
  </action>
  <!-- [DE] macOS: meta alt MULTIPLY 5 | meta alt MULTIPLY NUMPAD5 -->
  <action id="ExpandAllToLevel5">
    <keyboard-shortcut first-keystroke="meta alt #10000fc" second-keystroke="5"/>
  </action>
  <!-- [DE-alt] macOS: shift ENTER | meta ADD | meta EQUALS -->
  <action id="ExpandExpandableComponent">
    <keyboard-shortcut first-keystroke="shift ENTER"/>
  </action>
  <!-- [DE] macOS: meta ADD | meta EQUALS -->
  <action id="ExpandRegion">
    <keyboard-shortcut first-keystroke="meta PLUS"/>
  </action>
  <!-- [DE] macOS: meta alt ADD | meta alt EQUALS -->
  <action id="ExpandRegionRecursively">
    <keyboard-shortcut first-keystroke="meta alt PLUS"/>
  </action>
  <!-- [DE] macOS: meta MULTIPLY 1 | meta MULTIPLY NUMPAD1 -->
  <action id="ExpandToLevel1">
    <keyboard-shortcut first-keystroke="meta #10000fc" second-keystroke="1"/>
