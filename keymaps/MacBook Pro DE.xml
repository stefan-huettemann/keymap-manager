  <!-- [DE] macOS: meta SEMICOLON -->
  <action id="ShowProjectStructureSettings">
    <keyboard-shortcut first-keystroke="meta shift COMMA"/>
  </action>
  <!-- [clear] clears the plugin default -->
  <action id="Terminal.ClearPrompt"/>
  <!-- [clear] clears the plugin default -->
  <action id="Terminal.SearchInCommandHistory"/>
  <!-- [clear] clears the plugin default -->
  <action id="Vcs.CombinedDiff.ToggleCollapseBlock"/>
