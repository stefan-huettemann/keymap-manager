  <!-- [DE] macOS: meta MULTIPLY 2 | meta MULTIPLY NUMPAD2 -->
  <action id="ExpandToLevel2">
    <keyboard-shortcut first-keystroke="meta #10000fc" second-keystroke="2"/>
  </action>
  <!-- [DE] macOS: meta MULTIPLY 3 | meta MULTIPLY NUMPAD3 -->
  <action id="ExpandToLevel3">
    <keyboard-shortcut first-keystroke="meta #10000fc" second-keystroke="3"/>
  </action>
  <!-- [DE] macOS: meta MULTIPLY 4 | meta MULTIPLY NUMPAD4 -->
  <action id="ExpandToLevel4">
    <keyboard-shortcut first-keystroke="meta #10000fc" second-keystroke="4"/>
  </action>
  <!-- [DE] macOS: meta MULTIPLY 5 | meta MULTIPLY NUMPAD5 -->
  <action id="ExpandToLevel5">
    <keyboard-shortcut first-keystroke="meta #10000fc" second-keystroke="5"/>
  </action>
  <!-- [DE] macOS: ADD -->
  <action id="ExpandTreeNode">
    <keyboard-shortcut first-keystroke="PLUS"/>
  </action>
  <!-- [DE] macOS: meta SLASH -->
  <action id="FileChooser.GoToRoot">
    <keyboard-shortcut first-keystroke="meta NUMBER_SIGN"/>
