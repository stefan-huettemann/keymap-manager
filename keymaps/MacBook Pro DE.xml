<!--
  MacBook Pro DE - a macOS keymap for German (T1/ISO) MacBook Pro keyboards.

  This is a DELTA on top of "Mac OS X 10.5+": it declares ONLY the actions that
  have to deviate. Everything not listed here is inherited from the parent and
  therefore keeps its stock macOS binding.

  Do NOT re-state inherited bindings here. "Mac OS X 10.5+" is a
  MacOSDefaultKeymap: shortcuts it inherits from "$default" get Ctrl and Meta
  SWAPPED (MacOSDefaultKeymap.mapModifiers, applied in KeymapImpl at
  getParentShortcuts). Copying a "$default" row into this file verbatim yields
  the Windows form - that is how this keymap once shipped Ctrl-V for Paste.
  This keymap's name must not start with "Mac OS X", so it performs no
  conversion of its own; inheritance is the only correct route.

  Every declaration below falls into exactly one of three groups, and the
  comment on each records the stock macOS binding it replaces:

    [DE]     every macOS binding sat on a key absent from German T1
             (/ = [ ] ; ' ` INSERT, numpad) - key substituted, modifiers kept
    [DE-alt] a reachable binding survives; only an unreachable alternate is
             dropped
    [macOS]  macOS Spaces / Mission Control grabs the combo before the IDE
             sees it - O-umlaut = previous/left, A-umlaut = next/right
    [clear]  empty override clearing a conflicting plugin default

  Substitutions: / -> #   = and numpad + -> +   numpad - -> -
                 [ ] -> O-umlaut A-umlaut       ` -> sharp-s (editor windows)
                                                     less-than (project windows)
                 ' -> shift #   ; -> shift ,    numpad * fold prefix -> U-umlaut

  Keep the actions sorted alphabetically by id. Umlaut hex codes are
  machine-verified in keys.md - never compute them by hand.
-->
<keymap version="1" name="MacBook Pro DE" parent="Mac OS X 10.5+" disable-mnemonics="true">
  <!-- [DE-alt] macOS: meta C | meta INSERT -->
  <action id="$Copy">
    <keyboard-shortcut first-keystroke="meta C"/>
  </action>
  <!-- [DE-alt] macOS: meta V | shift INSERT -->
  <action id="$Paste">
    <keyboard-shortcut first-keystroke="meta V"/>
  </action>
  <!-- [DE-alt] macOS: meta OPEN_BRACKET | meta alt LEFT | mouse:button4 -->
  <action id="Back">
    <keyboard-shortcut first-keystroke="meta alt LEFT"/>
    <mouse-shortcut keystroke="button4"/>
  </action>
  <!-- [DE-alt] macOS: meta SUBTRACT | meta MINUS -->
  <action id="CollapseAll">
    <keyboard-shortcut first-keystroke="meta MINUS"/>
  </action>
  <!-- [DE-alt] macOS: meta shift SUBTRACT | meta shift MINUS -->
  <action id="CollapseAllRegions">
    <keyboard-shortcut first-keystroke="meta shift MINUS"/>
  </action>
  <!-- [DE-alt] macOS: shift ENTER | meta SUBTRACT | meta MINUS -->
  <action id="CollapseExpandableComponent">
    <keyboard-shortcut first-keystroke="shift ENTER"/>
    <keyboard-shortcut first-keystroke="meta MINUS"/>
  </action>
  <!-- [DE-alt] macOS: meta SUBTRACT | meta MINUS -->
  <action id="CollapseRegion">
    <keyboard-shortcut first-keystroke="meta MINUS"/>
  </action>
  <!-- [DE-alt] macOS: meta alt SUBTRACT | meta alt MINUS -->
  <action id="CollapseRegionRecursively">
    <keyboard-shortcut first-keystroke="meta alt MINUS"/>
  </action>
  <!-- [DE] macOS: SUBTRACT -->
  <action id="CollapseTreeNode">
    <keyboard-shortcut first-keystroke="MINUS"/>
  </action>
  <!-- [DE] macOS: meta alt SLASH | meta alt DIVIDE | control shift SLASH | control shift DIVIDE | meta shift SLASH | meta shift DIVIDE | meta shift DIVIDE -->
  <action id="CommentByBlockComment">
    <keyboard-shortcut first-keystroke="meta alt NUMBER_SIGN"/>
  </action>
  <!-- [DE] macOS: meta SLASH | meta DIVIDE -->
  <action id="CommentByLineComment">
    <keyboard-shortcut first-keystroke="meta NUMBER_SIGN"/>
  </action>
  <!-- [macOS] macOS: control shift RIGHT -->
  <action id="Diff.NextChange">
    <keyboard-shortcut first-keystroke="control shift #10000c4"/>
  </action>
  <!-- [macOS] macOS: control shift LEFT -->
  <action id="Diff.PrevChange">
    <keyboard-shortcut first-keystroke="control shift #10000d6"/>
  </action>
  <!-- [DE] macOS: meta alt CLOSE_BRACKET -->
  <action id="EditorCodeBlockEnd">
    <keyboard-shortcut first-keystroke="meta alt #10000c4"/>
  </action>
  <!-- [DE] macOS: meta alt shift CLOSE_BRACKET -->
  <action id="EditorCodeBlockEndWithSelection">
    <keyboard-shortcut first-keystroke="meta alt shift #10000c4"/>
  </action>
  <!-- [DE] macOS: meta alt OPEN_BRACKET -->
  <action id="EditorCodeBlockStart">
    <keyboard-shortcut first-keystroke="meta alt #10000d6"/>
  </action>
  <!-- [DE] macOS: meta alt shift OPEN_BRACKET -->
  <action id="EditorCodeBlockStartWithSelection">
    <keyboard-shortcut first-keystroke="meta alt shift #10000d6"/>
  </action>
  <!-- [DE] macOS: INSERT -->
  <action id="EditorToggleInsertState">
    <keyboard-shortcut first-keystroke="control #10000fc"/>
  </action>
  <!-- [DE] macOS: meta ADD | meta EQUALS -->
  <action id="ExpandAll">
    <keyboard-shortcut first-keystroke="meta PLUS"/>
  </action>
  <!-- [DE] macOS: meta shift ADD | meta shift EQUALS -->
  <action id="ExpandAllRegions">
    <keyboard-shortcut first-keystroke="meta shift PLUS"/>
  </action>
  <!-- [DE] macOS: meta alt MULTIPLY 1 | meta alt MULTIPLY NUMPAD1 -->
