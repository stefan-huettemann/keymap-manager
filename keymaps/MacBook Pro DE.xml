  </action>
  <!-- [DE] macOS: meta shift alt BACK_QUOTE -->
  <action id="PreviousProjectWindow">
    <keyboard-shortcut first-keystroke="meta shift LESS"/>
  </action>
  <!-- [macOS] macOS: meta shift OPEN_BRACKET | control LEFT -->
  <action id="PreviousTab">
    <keyboard-shortcut first-keystroke="meta shift #10000d6"/>
  </action>
  <!-- [DE] macOS: meta shift BACK_QUOTE -->
  <action id="PreviousWindow">
    <keyboard-shortcut first-keystroke="meta shift #10000df"/>
  </action>
  <!-- [DE] macOS: control BACK_QUOTE -->
  <action id="QuickChangeScheme">
    <keyboard-shortcut first-keystroke="control #10000df"/>
